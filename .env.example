# Next.js server-side API bridge. Never prefix with NEXT_PUBLIC_.
# In local development NestJS runs on port 3001.
KASSA_API_URL=http://127.0.0.1:3001

# Optional: testing the phone camera over an HTTPS development tunnel.
# Set to the exact temporary hostname printed by cloudflared (NO https://).
# Restart Next.js after changing it.
# KASSA_HTTPS_DEV_HOST=your-temporary-host.trycloudflare.com
