# Copy this file to .env and enter your LOCAL values. Never commit .env.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# URL-encode special characters in your PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kassa_dev?schema=public"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Paystack TEST MODE ONLY. Never commit real values or use sk_live_ here.
# Copy sk_test_... from Paystack Dashboard > Developers > API Keys (test mode).
PAYSTACK_SECRET_KEY=
# If configured on Paystack, use the whsec_... signing secret for modern webhooks.
# Without this secret, only Paystack's legacy x-paystack-signature can be verified.
PAYSTACK_WEBHOOK_SECRET=
# Paystack redirects here after checkout; must be an HTTPS public frontend origin.
# For Kassa production frontend:
FRONTEND_URL=https://kassa-bay.vercel.app
