# Copy this file to .env and enter your LOCAL values. Never commit .env.
NODE_ENV=development
PORT=3001
# In local development: http://localhost:3000; set the deployed HTTPS URL on Render.
FRONTEND_URL=https://kassa-bay.vercel.app
# URL-encode special characters in your PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kassa_dev?schema=public"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Paystack TEST MODE ONLY. Never commit real values or use sk_live_ here.
# Copy sk_test_... from Paystack Dashboard > Developers > API Keys (test mode).
PAYSTACK_SECRET_KEY=
# If configured on Paystack, use the whsec_... signing secret for modern webhooks.
# Without this secret, only Paystack's legacy x-paystack-signature can be verified.
PAYSTACK_WEBHOOK_SECRET=
# Paystack redirects here after checkout; must be an HTTPS public frontend origin.

# KASSA SOFTWARE SUBSCRIPTIONS ONLY (never merchant/customer checkout).
# Built-in PILOT test figures with sk_test_... when JSON below is left empty:
# monthly: ₦2,000 / 30d; quarterly: ₦5,000 / 90d; annual: ₦18,000 / 365d.
# These amounts are illustrative and are NOT approved production pricing.
# To override, supply an approved JSON catalog of code/name/amountKobo/durationDays;
# use only the tier codes monthly, quarterly and annual.
# A live Paystack key NEVER falls back to the illustrative test prices.
KASSA_BILLING_PLANS_JSON=
# Keep FALSE until prices, webhooks and live payments have been verified.
# For sk_live_ keys, true ALSO requires PAYSTACK_WEBHOOK_SECRET=whsec_...
KASSA_BILLING_LIVE_ENABLED=false
# Set Paystack's webhook endpoint in the provider dashboard to:
# https://YOUR-BACKEND-DOMAIN/api/v1/payments/paystack/webhook
# Successful payments extend the business subscription. Automatic renewal
# and subscription-based feature restrictions are deliberately NOT enabled.

# Subscription-based feature restrictions (capacity + premium features).
# Leave FALSE until the database migration, test payments, customer/staff access,
# existing businesses and upgrades have been verified. Enabling this on an
# existing unpaid business applies the FREE tier restrictions immediately.
KASSA_SUBSCRIPTION_FEATURE_GATES_ENABLED=false

# PRIVATE EXPENSE RECEIPTS — Cloudinary (configure on the backend / Render ONLY).
# Leave all three empty to retain the existing database receipt storage temporarily.
# Once all three values are set, NEW uploads use Cloudinary authenticated assets.
# Existing database receipts remain readable. Never set these in mobile/.env or EAS.
# Do not commit real keys. Rotate a key if it has ever been exposed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
