# Copy this file to .env and enter your LOCAL values. Never commit .env.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# URL-encode special characters in your PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kassa_dev?schema=public"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
