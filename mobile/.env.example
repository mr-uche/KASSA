# Public NestJS API address accessible from your phone, including /api/v1.
# Example for a local Windows laptop: http://192.168.1.10:3001/api/v1
# For deployed backend use: https://your-backend.example.com/api/v1
# Never place PAYSTACK_SECRET_KEY, JWT_SECRET or DATABASE_URL in this file.
EXPO_PUBLIC_KASSA_API_URL=

# Optional public support contacts (used by Help and Chat Support).
# Leave blank until real, approved contacts are available.
EXPO_PUBLIC_KASSA_SUPPORT_PHONE=
EXPO_PUBLIC_KASSA_SUPPORT_WHATSAPP=
EXPO_PUBLIC_KASSA_SUPPORT_EMAIL=
EXPO_PUBLIC_KASSA_SUPPORT_HOURS=
